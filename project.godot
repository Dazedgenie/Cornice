; SUMMIT TRICK - low poly snowboard racing
; Godot 4.x project file

config_version=5

[application]

config/name="Summit Trick"
config/description="A low-poly SSX-style snowboard racing game. Carve, launch, spin, grab and grind your way down three mountains."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.03, 0.07, 1)
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.12, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0
